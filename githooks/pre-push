#!/usr/bin/env sh
set -eu

zero=0000000000000000000000000000000000000000
verified=""

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" != "$zero" ] || continue
  case " $verified " in
    *" $local_sha "*) continue ;;
  esac
  python3 scripts/package_skills.py verify-dist-receipt \
    --source "commit:$local_sha" \
    --platform-set required \
    --skill split-testing
  verified="$verified $local_sha"
done
