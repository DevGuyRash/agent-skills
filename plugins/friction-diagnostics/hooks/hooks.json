{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\"; [ -n \"$p\" ] && [ -x \"$p/hooks/friction-session-env.sh\" ] && exec \"$p/hooks/friction-session-env.sh\"; exit 0'",
            "timeout": 10,
            "statusMessage": "Exporting friction session reference"
          }
        ]
      }
    ]
  }
}
