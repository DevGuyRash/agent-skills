{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparative-evidence-result.v1.schema.json",
  "title": "Comparative Evidence Result v1",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "request_digest",
    "tested_conditions",
    "conclusion",
    "closure_assessment",
    "evidence_refs",
    "scope_and_limits",
    "uncertainty",
    "reopening_conditions"
  ],
  "properties": {
    "schema": {"const": "comparative-evidence-result.v1"},
    "claim_id": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tested_conditions": {},
    "conclusion": {},
    "closure_assessment": {
      "type": "array",
      "description": "Contains exactly one assessment for every requested closure-condition ID and no unrequested IDs; this cross-document relation requires caller-side verification.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["condition_id", "status"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["closes", "narrows", "does_not_resolve"]}
        },
        "additionalProperties": true
      }
    },
    "evidence_refs": {"type": "array"},
    "scope_and_limits": {},
    "uncertainty": {},
    "reopening_conditions": {},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
